        "targetMode": "Phrasal Verbs"
},
    {
        "id": 46,
        "word": "Make up for",
        "trWord": "Telafi etmek/Kendini affettirmek",
        "phonetic": "/meɪk ʌp fɔːr/",
        "pos": "phrasal verb",
        "posTr": "deyimsel fiil",
        "engDef": "To compensate for something lost, missed, or done badly; to provide something good as a balance against something bad.",
        "trDef": "Kaybedilen, kaçırılan veya kötü yapılan bir şeyi tazmin etmek; olumsuz bir durumu olumlu bir hareketle dengelemek.",
        "engExample": "I bought her some flowers to make up for being late to our dinner date.",
        "trExample": "Akşam yemeği randevumuza geç kaldığım için kendimi affettirmek adına ona çiçek aldım.",
        "details": {
                "miniCase": "Jason missed his daughter's piano recital because of an urgent meeting at work. To make up for it, he took her to her favorite amusement park the following weekend. He wanted to show her that he truly valued their time together despite his busy schedule.",
                "trMiniCase": "Jason, işteki acil bir toplantı nedeniyle kızının piyano dinletisini kaçırdı. Bunu telafi etmek için sonraki hafta sonu onu en sevdiği eğlence parkına götürdü. Yoğun programına rağmen onunla geçirdiği vakte gerçekten değer verdiğini göstermek istedi.",
                "caseExamples": [
                        {
                                "tr": "Bu hafta sonu fazla mesai yaparak hafta içi kaybettiğimiz zamanı telafi etmeliyiz.",
                                "en": "We need to work overtime this weekend to make up for the time we lost during the week."
                        },
                        {
                                "tr": "Onun nezaketi ve yardımseverliği, tecrübe eksikliğini fazlasıyla telafi ediyor.",
                                "en": "His kindness and helpfulness more than make up for his lack of experience."
                        },
                        {
                                "tr": "Seni kırdığımı biliyorum, bunu telafi etmeme izin ver.",
                                "en": "I know I hurt your feelings; please let me make up for it."
                        }
                ]
        },
        "wordFamily": {},
        "targetMode": "Phrasal Verbs"
},
    {
        "id": 47,
        "word": "Make do with",
